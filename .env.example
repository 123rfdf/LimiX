# Copy this file to .env and use paths valid on your machine.
LIMIX_SOURCE_DIR=C:/path/to/LimiX
LIMIX_MODEL_PATH=C:/path/to/LimiX/cache/LimiX-2M.ckpt
LIMIX_CLASSIFICATION_CONFIG=C:/path/to/LimiX/config/cls_default_noretrieval.json
LIMIX_REGRESSION_CONFIG=C:/path/to/LimiX/config/reg_default_noretrieval.json
LIMIX_DEVICE=auto
LIMIX_CPU_FALLBACK=true
# Optional explicit interpreter. Otherwise scripts locate conda env "limix".
# LIMIX_PYTHON=C:/Users/you/anaconda3/envs/limix/python.exe
